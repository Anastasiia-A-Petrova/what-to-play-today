
---
import Layout from "../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

const dataDir = path.resolve("data");
const preparedDir = path.resolve("data/prepared");

const preparedFiles = fs
  .readdirSync(preparedDir)
  .filter((file) => file.endsWith(".json"));

const homeData = {};

for (const file of preparedFiles) {
  const slug = file.replace(".json", "");

  const sourcePath = path.join(dataDir, `${slug}.json`);
  const preparedPath = path.join(preparedDir, file);

  const events = fs.existsSync(sourcePath)
    ? JSON.parse(fs.readFileSync(sourcePath, "utf-8"))
    : [];

  const prepared = JSON.parse(
    fs.readFileSync(preparedPath, "utf-8")
  );

  /* Group music works by historical event */

  const eventMap = new Map(
    events.map((event) => [String(event.nID), event])
  );

  const groupedWorksMap = new Map();

  (prepared.works || []).forEach((work, index) => {
    const hasEventId =
      work.eventId !== undefined &&
      work.eventId !== null &&
      String(work.eventId).trim() !== "";

    const groupKey = hasEventId
      ? `event-${String(work.eventId)}`
      : `work-${index}`;

    if (!groupedWorksMap.has(groupKey)) {
      const sourceEvent = hasEventId
        ? eventMap.get(String(work.eventId))
        : null;

      groupedWorksMap.set(groupKey, {
        eventArtist: sourceEvent?.sArtist || "",
        year: sourceEvent?.nYear || work.year || null,
        description:
          sourceEvent?.sDescription ||
          work.eventDescription ||
          "",
        works: [],
      });
    }

    const group = groupedWorksMap.get(groupKey);

    if (!group.description && work.eventDescription) {
      group.description = work.eventDescription;
    }

    group.works.push({
      title: work.title || "",
      type: work.type || "song",
      artist: work.artist || "",
      coverUrl: work.coverUrl || null,
      youtubeUrl: work.youtubeUrl || null,
      chordsUrl: work.chordsUrl || null,
    });
  });

  const stories = Array.from(groupedWorksMap.values());

  homeData[slug] = {
    stories: stories.slice(0, 3).map((story) => ({
      ...story,
      works: story.works.slice(0, 2),
      moreWorksCount: Math.max(0, story.works.length - 2),
    })),

    events: events.slice(0, 4).map((event) => ({
      description: event.sDescription || "",
      artist: event.sArtist || "",
    })),

    people: (prepared.people || []).slice(0, 6).map((person) => ({
      name: person.name,
      year: person.year || null,
      photo: person.photo || null,
    })),

    peopleCount: (prepared.people || []).length,
    eventCount: events.length,
    worksCount: (prepared.works || []).length,
  };
}
---

<Layout
  title="What to Play Today?"
  description="Discover music connected with today's date and find ideas for what to play, listen to or learn."
>
  <!-- HERO -->

  <section class="hero">

    <div class="hero-topline">
      <span class="eyebrow">
        <span class="live-dot"></span>
        YOUR DAILY MUSIC JOURNAL
      </span>

      <span class="edition">MUSIC ARCHIVE · 365 DAYS</span>
    </div>

    <div class="hero-content">

      <div class="hero-main">

        <p class="hero-pretitle">A LITTLE MUSIC HISTORY, EVERY DAY</p>

        <h1>
          Every day has
          <span>a soundtrack.</span>
        </h1>

        <p class="hero-description">
          Discover the songs, artists, albums and moments
          that made this day unforgettable.
          And maybe find something worth playing yourself.
        </p>

        <a href="/" id="today-button" class="primary-button">
          <span>Explore today's music</span>
          <span class="button-arrow">↗</span>
        </a>

      </div>

      <div class="hero-aside">

        <div class="date-artwork">

          <span class="artwork-label">TODAY IN MUSIC</span>

          <div class="artwork-decoration">
            <img src="/logo-mark-pink.svg" alt="" class="hero-logo hero-logo-one" />
            <img src="/logo-mark-pink.svg" alt="" class="hero-logo hero-logo-two" />
            <img src="/logo-mark-pink.svg" alt="" class="hero-logo hero-logo-three" />
          </div>

          <div class="artwork-bottom">
            <span class="artwork-small">A NEW CHAPTER</span>
            <span class="artwork-title">365</span>
            <span class="artwork-caption">DAYS OF MUSIC</span>
          </div>

        </div>

        <div class="hero-aside-note">
          <span class="aside-line"></span>
          <span>One date. Countless stories.</span>
        </div>

      </div>

    </div>

    <div class="hero-bottom">
      <span>SCROLL TO DISCOVER</span>
      <span class="scroll-arrow">↓</span>
      <span class="hero-bottom-right">MUSIC NEVER STANDS STILL</span>
    </div>

  </section>


  <!-- TODAY'S MUSIC -->

  <section class="today-section" id="today">

    <div class="section-header">
      <div>
        <p class="section-kicker">01 / THE DAILY ARCHIVE</p>
        <h2>Today in music<span class="accent-dot">.</span></h2>
      </div>

      <div class="section-date">
        <span class="date-label">TODAY'S EDITION</span>
        <span id="today-date" class="date-value">Loading...</span>
      </div>
    </div>

    <!-- MUSIC HISTORY -->

    <div class="music-archive">

      <div class="archive-heading">
        <div>
          <span class="archive-overline">THE SOUNDTRACK OF THIS DAY</span>
          <h3>It happened <em>today.</em></h3>
        </div>

        <span class="archive-symbol">♫</span>
      </div>

      <div id="today-events" class="today-stories">
        <p class="loading-text">Discovering music history...</p>
      </div>

      <a href="/" id="history-link" class="archive-more">
        <span class="archive-more-text">
          Explore the complete story of this date
        </span>
        <span class="archive-more-arrow">→</span>
      </a>

    </div>

    <!-- ARTIST BIRTHDAYS -->

    <div class="birthday-archive" id="birthdays">

      <div class="birthday-heading">
        <div>
          <p class="section-kicker">THE PEOPLE BEHIND THE MUSIC</p>
          <h3>Born <em>today.</em></h3>
        </div>

        <a href="/" id="birthdays-link" class="birthday-link">
          All artists <span>↗</span>
        </a>
      </div>

      <div id="born-people" class="people-list">
        <p class="loading-text">Finding today's artists...</p>
      </div>

    </div>

    <div class="archive-footer">
      <span>EVERY DATE HAS ITS OWN MUSICAL STORY</span>
      <span class="archive-decoration">♫</span>
    </div>

  </section>


  <!-- HOW IT WORKS -->

  <section class="discover-section">

    <div class="discover-heading">

      <div>
        <p class="section-kicker">02 / YOUR NEXT DISCOVERY</p>

        <h2>
          Find your next
          <span>favorite sound.</span>
        </h2>
      </div>

      <p class="discover-description">
        A song you forgot. An artist you haven't heard of.
        A piece of music you've always wanted to learn.
        Start anywhere.
      </p>

    </div>


    <div class="discover-grid">

      <article class="discover-card discover-one">

        <div class="discover-number">01</div>

        <img src="/logo-mark.svg" alt="" class="discover-icon" />

        <div class="discover-card-bottom">
          <h3>Explore</h3>

          <p>
            Travel through music history.
            Discover what happened on any date.
          </p>
        </div>

        <span class="discover-decoration">DISCOVER MORE ↗</span>

      </article>


      <article class="discover-card discover-two">

        <div class="discover-number">02</div>

        <img src="/logo-mark.svg" alt="" class="discover-icon" />

        <div class="discover-card-bottom">
          <h3>Listen</h3>

          <p>
            Find songs and albums that deserve
            a place in your playlist.
          </p>
        </div>

        <span class="discover-decoration">FIND YOUR SOUND ↗</span>

      </article>


      <article class="discover-card discover-three">

        <div class="discover-number">03</div>

        <img src="/logo-mark.svg" alt="" class="discover-icon" />

        <div class="discover-card-bottom">
          <h3>Play</h3>

          <p>
            Find inspiration to pick up
            an instrument and start playing.
          </p>
        </div>

        <span class="discover-decoration">MAKE SOME MUSIC ↗</span>

      </article>

    </div>

  </section>


  <!-- BOTTOM CTA -->

  <section class="calendar-cta">

    <div class="cta-copy">
      <p class="section-kicker">03 / THE WHOLE YEAR IN MUSIC</p>

      <h2>
        There's always
        <span>another story.</span>
      </h2>

      <p>
        Every day, every year, every generation.
        Pick a date and see what the world was listening to.
      </p>
    </div>

    <a href="/calendar/" id="calendar-button" class="calendar-button">
      Explore the calendar
      <span>↗</span>
    </a>

    <div class="cta-decoration">365</div>

  </section>


  <script define:vars={{ homeData }}>
    const todayButton = document.querySelector("#today-button");
    const exploreLink = document.querySelector("#history-link");
    const birthdaysLink = document.querySelector("#birthdays-link");
    const calendarButton = document.querySelector("#calendar-button");

    const todayDate = document.querySelector("#today-date");
    const eventsContainer = document.querySelector("#today-events");
    const peopleContainer = document.querySelector("#born-people");

    // Safely escape dynamic content before inserting HTML.

    const escapeHTML = (value) =>
      String(value ?? "").replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[char]);

    // Remove HTML tags and decode entities in event descriptions.
    const plainText = (value) => {
      const doc = new DOMParser().parseFromString(
        String(value ?? ""),
        "text/html"
      );

      return (doc.body.textContent || "")
        .replace(/\s+/g, " ")
        .trim();
    };

    // Today's date

    const now = new Date();

    const dateParts = new Intl.DateTimeFormat("en-US", {
      month: "long",
      day: "2-digit",
    }).formatToParts(now);

    const month = dateParts
      .find((part) => part.type === "month")
      ?.value.toLowerCase();

    const day = dateParts
      .find((part) => part.type === "day")
      ?.value;

    if (!month || !day) {
      throw new Error("Could not determine today's date.");
    }

    const todaySlug = `${month}-${day}`;
    const todayUrl = `/${todaySlug}/`;

    const displayDate = new Intl.DateTimeFormat("en-US", {
      weekday: "long",
      month: "long",
      day: "numeric",
      year: "numeric",
    }).format(now);

    const data = homeData[todaySlug];

    // Update links

    if (todayButton) todayButton.href = todayUrl;
    if (exploreLink) exploreLink.href = todayUrl;
    if (birthdaysLink) birthdaysLink.href = `${todayUrl}#birthdays`;

    // Calendar page
    if (calendarButton) {
      calendarButton.href = "/calendar/";
    }

    // Display date

    if (todayDate) {
      todayDate.textContent = displayDate;
    }

    // Music stories

    if (eventsContainer) {
      if (data?.stories?.length) {

        eventsContainer.innerHTML = data.stories
          .map((story, index) => {

            const description = plainText(story.description);

            return `
              <article class="today-story">

                <div class="story-intro">

                  <div class="story-meta">
                    <span class="story-number">
                      ${String(index + 1).padStart(2, "0")}
                    </span>

                    ${
                      story.year
                        ? `<span class="story-year">${escapeHTML(story.year)}</span>`
                        : ""
                    }

                    <span class="story-label">ON THIS DAY</span>
                  </div>

                  ${
                    story.eventArtist
                      ? `<h4 class="story-title">${escapeHTML(story.eventArtist)}</h4>`
                      : `<h4 class="story-title">A moment in music</h4>`
                  }

                  ${
                    description
                      ? `<p class="story-description">${escapeHTML(description)}</p>`
                      : ""
                  }

                </div>

                <div class="story-music">

                  ${
                    story.works.length
                      ? story.works.map((work) => `
                        <article class="music-item">

                          <div class="music-cover">
                            ${
                              work.coverUrl
                                ? `
                                  <img
                                    src="${escapeHTML(work.coverUrl)}"
                                    alt="${escapeHTML(work.artist)} — ${escapeHTML(work.title)}"
                                    loading="lazy"
                                    onerror="this.remove(); this.parentElement.innerHTML='<span>♫</span>';"
                                  />
                                `
                                : `<span>♫</span>`
                            }
                          </div>

                          <div class="music-info">

                            <span class="music-type">
                              ${work.type === "album" ? "ALBUM" : "SONG"}
                            </span>

                            <h5>${escapeHTML(work.title)}</h5>

                            ${
                              work.artist
                                ? `<p>${escapeHTML(work.artist)}</p>`
                                : ""
                            }

                            <div class="music-actions">

                              ${
                                work.youtubeUrl
                                  ? `
                                    <a
                                      href="${escapeHTML(work.youtubeUrl)}"
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="music-action music-action-listen"
                                    >
                                      ▶ Listen
                                    </a>
                                  `
                                  : ""
                              }

                              ${
                                work.chordsUrl
                                  ? `
                                    <a
                                      href="${escapeHTML(work.chordsUrl)}"
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="music-action music-action-chords"
                                    >
                                      ♫ Chords
                                    </a>
                                  `
                                  : ""
                              }

                            </div>

                          </div>

                        </article>
                      `).join("")
                      : `<p class="empty-state">No music links available.</p>`
                  }

                </div>

                ${
                  story.moreWorksCount > 0
                    ? `<span class="story-extra">+ ${story.moreWorksCount} more works in the full archive</span>`
                    : ""
                }

              </article>
            `;
          })
          .join("");

      } else if (data?.events?.length) {

        eventsContainer.innerHTML = data.events
          .map((event, index) => `
            <article class="today-story today-story-text">

              <div class="story-intro">

                <div class="story-meta">
                  <span class="story-number">
                    ${String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="story-label">MUSIC HISTORY</span>
                </div>

                ${
                  event.artist
                    ? `<h4 class="story-title">${escapeHTML(event.artist)}</h4>`
                    : ""
                }

                <p class="story-description">
                  ${escapeHTML(plainText(event.description))}
                </p>

              </div>

            </article>
          `)
          .join("");

      } else {

        eventsContainer.innerHTML = `
          <p class="empty-state">
            No events have been added for this date yet.
            Explore the archive to discover more.
          </p>
        `;

      }
    }

    // Artist birthdays

    if (peopleContainer) {
      if (data?.people?.length) {
        peopleContainer.innerHTML = data.people
          .map((person) => `
            <div class="person">

              ${
                person.photo
                  ? `
                    <img
                      src="${escapeHTML(person.photo)}"
                      alt="${escapeHTML(person.name)}"
                      loading="lazy"
                    />
                  `
                  : `
                    <div class="person-placeholder">♪</div>
                  `
              }

              <div class="person-info">

                <a
                  class="person-name"
                  href="https://en.wikipedia.org/wiki/Special:Search?search=${encodeURIComponent(person.name)}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  ${escapeHTML(person.name)}
                </a>

                ${
                  person.year
                    ? `
                      <span class="person-year">
                        Born ${escapeHTML(person.year)}
                      </span>
                    `
                    : ""
                }

              </div>

            </div>
          `)
          .join("");
      } else {
        peopleContainer.innerHTML = `
          <p class="empty-state">
            No birthdays recorded for this date yet.
          </p>
        `;
      }
    }
  </script>

<style is:global>

