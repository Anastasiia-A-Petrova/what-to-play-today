  padding: 16px 0 25px;
  margin-bottom: 110px;
}

.hero-topline,
.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}

.hero-topline {
  padding-bottom: 18px;
}

.eyebrow,
.edition,
.hero-pretitle,
.hero-bottom,
.artwork-label,
.artwork-small,
.artwork-caption,
.section-kicker,
.date-label,
.archive-overline,
.story-meta,
.music-type,
.archive-footer,
.discover-number,
.discover-decoration {
  font-family: var(--font-mono, monospace);
