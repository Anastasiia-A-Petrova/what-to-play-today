---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  isDatePage?: boolean;
}

const { isDatePage = false } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCalendarPage = currentPath === "/calendar";

---

<header class="site-header">
  <div class="header-inner">

    <a href="/" class="logo" aria-label="What to Play Today — Home">
      <img
        src="/logo.svg"
        alt=""
        class="logo-image"
        width="44"
        height="44"
      />

      <span class="logo-copy">
        <span class="logo-name">WHAT TO PLAY TODAY?</span>
        <span class="logo-caption">MUSIC ARCHIVE</span>
      </span>
    </a>

    <p class="header-note">
      <span>A little music history.</span>
      <span>A new reason to listen.</span>
    </p>

    <nav class="main-nav" aria-label="Main navigation">
      <a
        href="/calendar/"
        class="nav-link"
        aria-current={isCalendarPage ? "page" : undefined}
      >
        Calendar
      </a>

      <a href="/" id="today-link" class="nav-link today-link">
        <span class="today-dot" aria-hidden="true"></span>
        Today
      </a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
    </div>

  </div>

  {isDatePage && (
    <nav class="date-nav" aria-label="On this page">

      <span class="date-nav-label">EXPLORE THIS DAY</span>

      <div class="date-nav-links">
        <a href="#play">
          <span class="date-nav-icon">♫</span>
          What to Play
        </a>

        <a href="#history">
          <span class="date-nav-icon">✳</span>
          Music History
        </a>

        <a href="#birthdays">
          <span class="date-nav-icon">✦</span>
          Born Today
        </a>
      </div>

    </nav>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    padding: 15px 24px;

    background: color-mix(in srgb, var(--bg) 88%, transparent);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    border-bottom: 1px solid var(--border);
  }

  /* HEADER LAYOUT */

  .header-inner {
    width: min(var(--content-width, 1240px), 100%);
    min-height: 44px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    gap: 36px;
  }

  /* LOGO */

  .logo {
    display: flex;
    align-items: center;
    gap: 11px;

    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-image {
    width: 44px;
    height: 44px;
    object-fit: contain;
    flex-shrink: 0;

    transition: transform 0.25s ease;
  }

  .logo:hover .logo-image {
    transform: rotate(-5deg) scale(1.06);
  }

  .logo-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .logo-name {
    font-size: 14px;
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .logo-caption {
    font-family: var(--font-mono, monospace);
    font-size: 8px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  /* MAIN NAVIGATION */

  .main-nav {
    display: flex;
    align-items: center;
    gap: 9px;

    margin-left: auto;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;

    padding: 9px 14px;
    border-radius: 30px;

    color: var(--muted);
    text-decoration: none;

    font-size: 13px;
    font-weight: 650;

    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text);
    background: var(--surface-soft);
  }

  .nav-link[aria-current="page"] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .today-link {
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .today-link:not([aria-current="page"]):hover {
    color: var(--accent);
    background: var(--surface);
  }

  .today-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* HEADER ACTIONS */

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* DATE NAVIGATION */

  .date-nav {
    width: min(var(--content-width, 1240px), 100%);
    margin: 13px auto 0;
    padding-top: 12px;

    border-top: 1px solid var(--border);

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .date-nav-label {
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--muted);
    white-space: nowrap;
  }

  .date-nav-links {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .date-nav a {
    display: flex;
    align-items: center;
    gap: 7px;

    padding: 7px 12px;
    border-radius: 30px;

    color: var(--muted);
    text-decoration: none;

    font-size: 12px;
    font-weight: 650;
    white-space: nowrap;

    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .date-nav a:hover,
  .date-nav a:focus-visible {
    color: var(--text);
    background: var(--surface-soft);
  }

  .date-nav-icon {
    color: var(--accent);
    font-size: 15px;
  }

  /* EDITORIAL HEADER */

  .header-note {
    display: none;
  }

  @media (min-width: 1000px) {
    .header-inner {
      min-height: 52px;
      gap: 24px;
    }

    .logo {
      gap: 13px;
    }

    .logo-image {
      width: 50px;
      height: 50px;
    }

    .logo-name {
      font-size: 17px;
    }

    .logo-caption {
      margin-top: 3px;
      font-size: 9px;
      letter-spacing: 0.12em;
    }

    .header-note {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      gap: 2px;

      margin: 0;
      padding-left: 24px;
      border-left: 1px solid var(--border);

      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    .header-note span:first-child {
      color: var(--text);
      font-family: var(--font-editorial);
      font-size: 17px;
      line-height: 1.3;
    }

    .main-nav {
      gap: 8px;
    }

    .nav-link {
      min-height: 44px;
      padding: 10px 16px;
      font-size: 14px;
    }

    .header-actions {
      padding-left: 20px;
      border-left: 1px solid var(--border);
    }

    .date-nav {
      justify-content: center;
      gap: 20px;
      margin-top: 15px;
      padding-top: 12px;
    }

    .date-nav-label {
      font-size: 10px;
      letter-spacing: 0.12em;
    }

    .date-nav-links {
      gap: 12px;
    }

    .date-nav a {
      padding: 8px 14px;
      font-size: 13px;
    }
  }

  /* RESPONSIVE */

  @media (max-width: 700px) {
    .site-header {
      padding: 12px 16px;
    }

    .header-inner {
      gap: 10px;
    }

    .logo {
      gap: 8px;
    }

    .logo-image {
      width: 38px;
      height: 38px;
    }

    .logo-name {
      font-size: 11px;
    }

    .logo-caption {
      font-size: 7px;
    }

    .main-nav {
      gap: 2px;
    }

    .nav-link {
      padding: 8px 9px;
      font-size: 11px;
    }

    .header-actions {
      gap: 5px;
    }

    .date-nav {
      justify-content: flex-start;
      gap: 8px;
      padding-top: 10px;
      margin-top: 10px;

      overflow-x: auto;
      scrollbar-width: none;
    }

    .date-nav::-webkit-scrollbar {
      display: none;
    }

    .date-nav-label {
      display: none;
    }

    .date-nav-links {
      flex: 0 0 auto;
    }

    .date-nav a {
      padding: 7px 10px;
      font-size: 11px;
    }
  }

  @media (max-width: 390px) {

    .logo-name {
      font-size: 10px;
    }

    .nav-link {
      padding: 7px;
      font-size: 10px;
    }
  }
</style>

<script>
  function updateTodayLink() {
    const todayLink =
      document.querySelector<HTMLAnchorElement>("#today-link");

    if (!todayLink) return;

    const parts = new Intl.DateTimeFormat("en-US", {
      month: "long",
      day: "2-digit",
    }).formatToParts(new Date());

    const month = parts
      .find((part) => part.type === "month")
      ?.value.toLowerCase();

    const day = parts.find((part) => part.type === "day")?.value;

    if (!month || !day) return;

    const todayPath = `/${month}-${day}`;
    const currentPath =
      window.location.pathname.replace(/\/+$/, "") || "/";

    todayLink.href = `${todayPath}/`;

    if (currentPath === todayPath) {
      todayLink.setAttribute("aria-current", "page");
    } else {
      todayLink.removeAttribute("aria-current");
    }
  }

  updateTodayLink();

  document.addEventListener("astro:page-load", updateTodayLink);

  // Обновляем дату при возвращении к давно открытой вкладке.
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      updateTodayLink();
    }
  });
</script>
