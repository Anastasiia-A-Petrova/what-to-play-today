    color: var(--accent);
  }

  .search-clear[hidden] {
    display: none;
  }

  /* Search result highlight */

  :global(.search-highlight) {
    padding: 2px 5px;
    border-radius: 5px;

    background: #ffe08a;
    color: #352719;

    font-weight: 800;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;

    outline: 1px solid #e9b94d;
  }

</style>

<script>

// Search across the current date page

const searchInput = document.querySelector("#date-search");
const searchStatus = document.querySelector("#search-status");
const searchClear = document.querySelector("#search-clear");

if (searchInput && searchStatus) {
  const normalize = (value) =>
    String(value || "")
      .toLocaleLowerCase()
      .replace(/\s+/g, " ")
      .trim();

  const getSearchText = (element) => {
    if (!element) return "";

    const clone = element.cloneNode(true);

    // Исключаем кнопки и элементы управления.
    clone.querySelectorAll(
      "button, .work-actions, .action-link"
    ).forEach((el) => el.remove());

    return normalize(clone.textContent || "");
  };

  const storyCards = [
    ...document.querySelectorAll(".story-card")
  ];

  const historyCards = [
    ...document.querySelectorAll(".history-card")
  ];

  const birthdayCards = [
    ...document.querySelectorAll(".birthday-card")
  ];

  const allCards = [
    ...storyCards,
    ...historyCards,
    ...birthdayCards
  ];

  // Remove previous highlights.
  const clearHighlights = () => {
    document.querySelectorAll(".search-highlight").forEach((mark) => {
      const parent = mark.parentNode;

      mark.replaceWith(
        document.createTextNode(mark.textContent || "")
      );

      parent?.normalize();
    });
  };

  // Highlight matching words without regular expressions.
  const highlightMatches = (root, query) => {
    const words = query
      .split(/\s+/)
      .map((word) => word.trim())
      .filter(Boolean);

    if (!words.length) return;

    const walker = document.createTreeWalker(
      root,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node) {
          const parent = node.parentElement;

          if (
            !parent ||
            parent.closest(
              "script, style, button, .work-actions, .action-link, .search-highlight, .search-hidden"
            )
          ) {
            return NodeFilter.FILTER_REJECT;
          }

          return NodeFilter.FILTER_ACCEPT;
        }
      }
    );

    const textNodes = [];

    while (walker.nextNode()) {
      textNodes.push(walker.currentNode);
    }

    textNodes.forEach((node) => {
      const text = node.textContent || "";
      const lowerText = text.toLocaleLowerCase();

      const fragment = document.createDocumentFragment();
      let position = 0;
      let hasMatch = false;

      while (position < text.length) {
        let nextIndex = -1;
        let matchedWord = "";

        // Ищем ближайшее совпадение с любым словом запроса.
        for (const word of words) {
          const index = lowerText.indexOf(
            word.toLocaleLowerCase(),
            position
          );

          if (index !== -1 && (nextIndex === -1 || index < nextIndex)) {
            nextIndex = index;
            matchedWord = text.slice(index, index + word.length);
          }
        }

        if (nextIndex === -1) break;

        if (nextIndex > position) {
          fragment.append(
            document.createTextNode(text.slice(position, nextIndex))
          );
        }

        const mark = document.createElement("mark");
        mark.className = "search-highlight";
        mark.textContent = matchedWord;

        fragment.append(mark);

        position = nextIndex + matchedWord.length;
        hasMatch = true;
      }

      if (hasMatch) {
        if (position < text.length) {
          fragment.append(
            document.createTextNode(text.slice(position))
          );
        }

        node.replaceWith(fragment);
      }
    });
  };

  searchInput.addEventListener("input", () => {
    const query = normalize(searchInput.value);

    clearHighlights();

    if (searchClear) {
      searchClear.hidden = !query;
    }

    let visibleCount = 0;

    // Music stories
    storyCards.forEach((card) => {
      const header = card.querySelector(".story-header");
      const description = card.querySelector(".story-description");

      const storyText = [
        getSearchText(header),
        getSearchText(description)
      ].join(" ");

      const storyMatches =
        !query || storyText.includes(query);

      const works = [
        ...card.querySelectorAll(".work-item")
      ];

      let visibleWorks = 0;

      works.forEach((work) => {
        const matches =
          !query ||
          storyMatches ||
          getSearchText(work).includes(query);

        work.classList.toggle("search-hidden", !matches);

        if (matches) visibleWorks++;
      });

      const cardMatches =
        !query ||
        storyMatches ||
        visibleWorks > 0;

      card.classList.toggle("search-hidden", !cardMatches);

      if (cardMatches) visibleCount++;
    });

    // Historical events
    historyCards.forEach((card) => {
      const matches =
        !query || getSearchText(card).includes(query);

      card.classList.toggle("search-hidden", !matches);

      if (matches) visibleCount++;
    });

    // Artist birthdays
    birthdayCards.forEach((card) => {
      const matches =
        !query || getSearchText(card).includes(query);

      card.classList.toggle("search-hidden", !matches);

      if (matches) visibleCount++;
    });

    // Highlight matching text
    if (query) {
      allCards.forEach((card) => {
        if (!card.classList.contains("search-hidden")) {
          highlightMatches(card, query);
        }
      });
    }

    // Search status
    if (!query) {
      searchStatus.textContent = "Search across all sections";
    } else if (visibleCount === 0) {
      searchStatus.textContent =
        "No matches found. Try another search.";
    } else {
      searchStatus.textContent =
        `${visibleCount} matching ${visibleCount === 1 ? "item" : "items"}`;
    }
  });

  // Clear search
  if (searchClear) {
    searchClear.addEventListener("click", () => {
      searchInput.value = "";
      searchInput.dispatchEvent(new Event("input", { bubbles: true }));
      searchInput.focus();
    });
  }
}

  // Общая блокировка: одновременно выполняется только одна операция Share.
  let shareInProgress = false;

  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;

    const button = event.target.closest(".share-button");

    if (!(button instanceof HTMLButtonElement)) return;

    if (
      shareInProgress ||
      button.disabled ||
      button.dataset.busy === "true"
    ) {
      return;
    }

    const title = button.dataset.shareTitle || document.title;
    const anchor = button.dataset.shareAnchor;

    if (!anchor) return;

    const shareUrl = new URL(window.location.href);

    // Убираем query-параметры и заменяем текущий якорь.
    shareUrl.search = "";
    shareUrl.hash = anchor;

    const url = shareUrl.href;
    const originalText = button.textContent;

    shareInProgress = true;
    button.dataset.busy = "true";

    try {
      if (typeof navigator.share === "function") {
        try {
          const shareText = [
            `🎵 ${title}`,
            "",
            "Discover more music history, iconic songs and artist birthdays on What to Play Today?",
            "",
            "🎧 Explore music history every day:",
            "https://what-to-play-today.pages.dev/",
            "",
            "🔗 Explore this story:",
            url,
          ].join("\n");

          await navigator.share({
            title: "What to Play Today?",
            text: shareText,
          });

          return;
        } catch (error) {
          // Пользователь отменил отправку — ничего больше не делаем.
          if (
            error instanceof DOMException &&
            error.name === "AbortError"
          ) {
            return;
          }

          // При другой ошибке переходим к копированию.
        }
      }

      try {
        if (!navigator.clipboard?.writeText) {
          throw new Error("Clipboard API is unavailable");
        }

        await navigator.clipboard.writeText(url);
      } catch {
        window.prompt("Copy this link:", url);
        return;
      }

      button.textContent = "✓ Copied";

      // Сохраняем блокировку до завершения текущего обработчика.
      // Она будет снята в finally.
      await new Promise<void>((resolve) => {
        window.setTimeout(resolve, 1800);
      });

    } finally {
      button.textContent = originalText;
      delete button.dataset.busy;
      shareInProgress = false;
    }
  });
</script>


